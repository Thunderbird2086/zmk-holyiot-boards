# HolyIOT YJ-17120 (nRF52840) — ZMK variant, interconnect board
#
# Flash layout (S140 v7.3.0):
#   0x00000000 - 0x00000FFF   MBR
#   0x00001000 - 0x00026FFF   SoftDevice S140
#   0x00027000 - 0x000D2FFF   ZMK application
#   0x000D3000 - 0x000DFFFF   ZMK settings (NVS / FCB)
#   0x000E0000 - 0x000FDFFF   OpenDFU USB bootloader (protected)
#   0x000FE000 - 0x000FFFFF   UICR

CONFIG_BUILD_OUTPUT_HEX=y

CONFIG_ARM_MPU=y
CONFIG_PINCTRL=y
CONFIG_GPIO=y

# Code partition from DT → app links at 0x27000, ends at 0xD3000
CONFIG_FLASH=y
CONFIG_FLASH_MAP=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_USE_DT_CODE_PARTITION=y

# Settings (NVS / FCB) persist across flashes
CONFIG_NVS=y
CONFIG_SETTINGS=y
CONFIG_SETTINGS_NVS=y

# USB HID out to host
CONFIG_ZMK_USB=y
CONFIG_ZMK_KEYBOARD_NAME="YJ17120"

# BLE is available to the shield/target; split role is decided by the shield.
CONFIG_ZMK_BLE=y
