# HolyIOT YJ-17120 USB Dongle (nRF52840) — keyless BLE split-central
#
# Flash layout:
#   0x00000000 - 0x00000FFF   MBR
#   0x00001000 - 0x00026FFF   SoftDevice S140 (new layout)
#   0x00027000 - 0x000D2FFF   ZMK application
#   0x000D3000 - 0x000DFFFF   ZMK settings (NVS / FCB)
#   0x000E0000 - 0x000FDFFF   OpenDFU USB bootloader (protected)
#   0x000FE000 - 0x000FFFFF   UICR

CONFIG_BUILD_OUTPUT_HEX=y

CONFIG_ARM_MPU=y
CONFIG_PINCTRL=y
CONFIG_GPIO=y

# Code partition from DT → app links at 0x23000, ends at 0xD3000
CONFIG_FLASH=y
CONFIG_FLASH_MAP=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_USE_DT_CODE_PARTITION=y

# Settings (NVS / FCB) persist across flashes
CONFIG_NVS=y
CONFIG_SETTINGS=y
CONFIG_SETTINGS_NVS=y

# USB HID out to host
CONFIG_ZMK_USB=y

# BLE dongle: central role receiving split peripherals
CONFIG_ZMK_BLE=y
CONFIG_ZMK_SPLIT=y
CONFIG_ZMK_SPLIT_ROLE_CENTRAL=y
CONFIG_ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS=3
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING=y
